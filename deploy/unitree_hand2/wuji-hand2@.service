[Unit]
Description=Wuji Hand2 %i command server
Requires=docker.service wuji-hand2-network.service
After=docker.service wuji-hand2-network.service

[Service]
Type=simple
EnvironmentFile=/etc/default/wuji-hand2
ExecStartPre=/usr/bin/docker image inspect --format={{.Id}} ${HAND2_IMAGE}
ExecStart=/opt/glove_to_hand/deploy/unitree_hand2/run_hand2_container.sh %i
ExecStop=-/usr/bin/docker stop --time 3 wuji-hand2-%i
Restart=on-failure
RestartSec=2
TimeoutStartSec=30
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
