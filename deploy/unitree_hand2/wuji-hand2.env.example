# This gate must stay explicit.  A running server still leaves the hand disabled
# until it receives the first valid, non-zero, side-matched command frame.
ENABLE_HAND2=0
HAND2_IMAGE=codex/glove-to-hand-hand2:7abfcdb

LEFT_PORT=8765
RIGHT_PORT=8767
LEFT_HAND_SN=
RIGHT_HAND_SN=
LEFT_HAND_ADDRESS=192.168.1.110:7447
RIGHT_HAND_ADDRESS=192.168.1.111:7447

CONTROL_RATE=200
SMOOTH_TAU=0.02
MAX_JOINT_VELOCITY=6.0
# Optional CPU latency budget. Keep empty for the optimizer default (50).
RETARGET_MAXEVAL=
COMMAND_TIMEOUT=1.0
KP=3.5
KD=0.1
CURRENT_LIMIT=1.5
PRINT_EVERY=0.5
DATA_COLLECTOR_HOST=192.168.123.222
DEBUG_LATENCY=0
