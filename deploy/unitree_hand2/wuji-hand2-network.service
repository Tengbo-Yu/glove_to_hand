[Unit]
Description=Wuji Hand2 direct host routes (management-safe)
Wants=network-online.target
After=NetworkManager.service network-online.target
Before=wuji-hand2@left.service wuji-hand2@right.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/glove_to_hand/deploy/unitree_hand2/configure_hand2_network.sh start
ExecStop=/opt/glove_to_hand/deploy/unitree_hand2/configure_hand2_network.sh stop

[Install]
WantedBy=multi-user.target
